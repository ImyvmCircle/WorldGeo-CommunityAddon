{
	"schemaVersion": 1,
	"id": "community",
	"version": "${version}",
	"name": "WorldGeo-CommunityAddon",
	"description": "An extension mod for ImyvmWorldGeo to provide community features.",
	"authors": [
		"Doohaey Re"
	],
	"contact": {
		"homepage": "https://github.com/ImyvmCircle",
		"sources": "https://github.com/ImyvmCircle/WorldGeo-CommunityAddon"
	},
	"license": "GPL-3",
	"icon": "assets/community/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.imyvm.community.WorldGeoCommunityAddon",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"community.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"hoki": ">=1.1.6",
		"imyvm_economy": ">=26.2-1.2.7",
		"imyvmworldgeo": ">=26.2-1.5.6"
